<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="id.kakzaki.blue_thermal_printer">
    <!-- Visibility paket Android 11+ supaya bindService ke servis printer
         bawaan Sunmi (vendor/sunmi/) berhasil menemukan servisnya, tanpa
         perlu tiap app konsumen menambahkan ini sendiri. -->
    <queries>
      <package android:name="woyou.aidlservice.jiuiv5" />
      <!-- Servis printer bawaan Xcheng (vendor/xcheng/, backend opsional). Di perangkat Xcheng
           servis ini juga yang menyediakan AIDL kompatibel Sunmi di atas. -->
      <package android:name="com.xcheng.printerservice" />
      <!-- Servis printer bawaan iMin SDK 2.0 (vendor/imin/). -->
      <package android:name="com.imin.printerservice" />
    </queries>

    <!-- Transport ESC/POS LAN (transport/net/): socket TCP ke printer jaringan. Izin normal,
         diberikan otomatis saat instal. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Transport ESC/POS USB (transport/usb/). required="false" supaya app tetap bisa dipasang di
         perangkat tanpa USB host; ketersediaannya dicek saat runtime. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>

    <!-- Bluetooth Classic (SPP) untuk printer ESC/POS + kontrol adapter (transport/bluetooth/).
         Rincian per operasi/versi Android: doc/bluetooth-control-design.md. Manifest ini ikut
         ter-merge ke SEMUA app konsumen, jadi sengaja minimal. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false"/>

    <!-- API <= 30: izin normal (otomatis saat instal) untuk koneksi, nyala/mati, pencarian, dan
         pairing. API 31+ digantikan BLUETOOTH_SCAN/BLUETOOTH_CONNECT. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>

    <!-- API 23-30: pencarian perangkat Bluetooth wajib izin lokasi. FINE sudah mencakup lokasi
         kasar, jadi ACCESS_COARSE_LOCATION tidak dideklarasikan. App yang butuh lokasi untuk
         keperluan lain mendeklarasikan izinnya sendiri. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30"/>

    <!-- API 31+: "Perangkat sekitar". Hasil pencarian tidak pernah dipakai untuk lokasi, jadi
         tanpa izin lokasi. App yang menurunkan lokasi dari hasil scan harus menimpa flag ini
         lewat tools:replace="android:usesPermissionFlags". -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

</manifest>

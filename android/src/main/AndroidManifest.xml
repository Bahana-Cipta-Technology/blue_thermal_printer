<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="id.kakzaki.blue_thermal_printer">
    <!-- Visibility paket Android 11+ supaya bindService ke servis printer
         bawaan Sunmi (vendor/sunmi/) berhasil menemukan servisnya, tanpa
         perlu tiap app konsumen menambahkan ini sendiri. -->
    <queries>
      <package android:name="woyou.aidlservice.jiuiv5" />
      <!-- Servis printer bawaan Xcheng (vendor/xcheng/, backend opsional). Di perangkat Xcheng
           servis ini juga yang menyediakan AIDL kompatibel Sunmi di atas. -->
      <package android:name="com.xcheng.printerservice" />
      <!-- Servis printer bawaan iMin SDK 2.0 (vendor/imin/). -->
      <package android:name="com.imin.printerservice" />
    </queries>

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Request legacy Bluetooth permissions on older devices. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>

    <!-- Needed only if your app looks for Bluetooth devices.
         You must add an attribute to this permission, or declare the
         ACCESS_FINE_LOCATION permission, depending on the results when you
         check location usage in your app. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- Needed only if your app makes the device discoverable to Bluetooth
         devices. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- Needed only if your app communicates with already-paired Bluetooth
         devices. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

</manifest>
